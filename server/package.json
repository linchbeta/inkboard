{
  "name": "inkboard",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight self-hosted backend for ESP32 e-paper displays (InkSight-compatible)",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"tests/**/*.test.ts\"",
    "fonts:subset": "tsx scripts/subset-fonts.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "lunar-javascript": "^1.7.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
